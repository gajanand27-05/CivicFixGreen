# Copy to server/.env and fill in. server/.env is git-ignored.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Optional: email. Leave blank to run without email (complaints still tracked in-app).
GMAIL_ADDRESS=
GMAIL_APP_PASSWORD=
DEMO_OFFICE_EMAIL=
SEND_TO_REAL_BBMP=false

REMINDER_AFTER_MINUTES=7200
REMINDER_REPEAT_MINUTES=2880
MAX_REMINDERS=3
POLL_SECONDS=60
PUBLIC_BASE_URL=http://localhost:8000
