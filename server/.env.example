# Copy to server/.env and fill in. server/.env is git-ignored. Restart the server after editing.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash,gemini-3.7-flash,gemini-2.5-flash

# ---- Email (optional; without it complaints are tracked in the app only) ----
# GMAIL_ADDRESS: the Gmail account that sends complaints and receives BBMP replies.
# GMAIL_APP_PASSWORD: a 16-character App Password (NOT your normal password):
#   Google Account > Security > turn on 2-Step Verification > App passwords > create one.
#   Also check Gmail > Settings > Forwarding and POP/IMAP > IMAP is enabled.
GMAIL_ADDRESS=
GMAIL_APP_PASSWORD=
# DEMO_OFFICE_EMAIL: inbox that plays the "BBMP officer" (e.g. a teammate's Gmail).
# Leave blank to send office emails to GMAIL_ADDRESS itself (as GMAIL+bbmp-<zone>@gmail.com).
DEMO_OFFICE_EMAIL=
# Real official office addresses are used only when true AND filled in server/bbmp_offices.json.
SEND_TO_REAL_BBMP=false

REMINDER_AFTER_MINUTES=7200
REMINDER_REPEAT_MINUTES=2880
MAX_REMINDERS=3
POLL_SECONDS=60
PUBLIC_BASE_URL=http://localhost:8000
